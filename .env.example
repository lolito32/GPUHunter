PORT=3000
HOST=0.0.0.0

# Minutos entre sincronizaciones (10-15 recomendado)
SYNC_INTERVAL_MIN=12

# Carpeta de datos (en Render/Railway usar un disco persistente)
DATA_DIR=./data

# Token de admin para escrituras desde la PWA (recomendado en produccion)
# GET -> PUT /api/settings y POST /api/sync exigiran cabecera X-Admin-Token
ADMIN_TOKEN=

# Telegram (tambien se puede configurar desde la PWA)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Maximas paginas a recorrer por tienda en cada ciclo
MAX_PAGES=4
